{
  "name": "ldgraph",
  "version": "0.1.0",
  "description": "Safe, typed JSON-LD for React Server Components: one linked graph across layouts and pages, zero dependencies.",
  "keywords": [
    "json-ld",
    "schema.org",
    "structured-data",
    "seo",
    "nextjs",
    "react-server-components",
    "app-router"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./check": {
      "types": "./dist/check.d.ts",
      "default": "./dist/check.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=20.9"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:types": "tsc -p test/types/tsconfig.v1.json && tsc -p test/types/tsconfig.v2.json",
    "test:react18": "npm --prefix test/react18 install --install-links --no-package-lock --no-audit --no-fund && node --test test/react18/ssr.test.mjs",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "lint": "npm run typecheck && npm run test:types && npm run lint:pkg",
    "lint:pkg": "publint --strict && attw --pack --profile esm-only",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "parse5": "^8.1.1",
    "playwright-core": "~1.65.1",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "schema-dts": "^2.1.0",
    "schema-dts-v1": "npm:schema-dts@^1.1.5",
    "typescript": "~5.9.3",
    "vitest": "^4.1.12"
  }
}
