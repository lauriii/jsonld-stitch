{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": false,
    "noEmit": true,
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "paths": {
      "jsonld-stitch": ["../../src/index.ts"],
      "jsonld-stitch/check": ["../../src/check.ts"]
    }
  },
  "files": ["types.test.ts", "jsx.test.tsx"]
}
